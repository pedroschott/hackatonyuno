{
  "name": "@agentic-mandates/workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "./node_modules/.bin/pnpm -r --if-present --sort run build",
    "dev": "./node_modules/.bin/pnpm -r --if-present --parallel run dev",
    "test": "./node_modules/.bin/pnpm -r --if-present --sort run test",
    "typecheck": "./node_modules/.bin/pnpm -r --if-present --sort run typecheck"
  },
  "devDependencies": {
    "pnpm": "10.34.5",
    "typescript": "5.9.3"
  }
}
