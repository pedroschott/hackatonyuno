NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Used only by the local Supabase Auth stack; production stores this in Supabase SMTP settings.
RESEND_API_KEY=re_your_resend_api_key
# Server-only Supabase secret key used by the authenticated Didit callback and signed webhook handler.
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Server-only Didit v3 credentials. Configure a KYC workflow with the fraud checks you require.
DIDIT_API_KEY=your-didit-api-key
DIDIT_WORKFLOW_ID=00000000-0000-0000-0000-000000000000
DIDIT_WEBHOOK_SECRET=your-didit-webhook-destination-secret
# Server-only proof for live-domain verification. Generate with `openssl rand -hex 32`.
MERCHANT_VERIFICATION_SECRET=replace-with-64-hex-character-secret
AGENTPAY_BASE_URL=http://localhost:3210
AGENTPAY_RP_NAME=AgentPay
# The WebAuthn RP ID must exactly match the canonical AgentPay hostname.
AGENTPAY_RP_ID=localhost
AGENTPAY_RP_ORIGIN=http://localhost:3210
AGENTPAY_ENCRYPTION_KEY=replace-with-32-byte-base64-secret
AGENTPAY_REGISTRY_PRIVATE_KEY=replace-with-base64-pkcs8-ed25519-private-key
AGENTPAY_REGISTRY_PUBLIC_KEY=replace-with-base64-spki-ed25519-public-key
