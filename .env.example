NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Server-only Supabase key used only after a route has authenticated a user or
# verified an inbound provider signature. A legacy SUPABASE_SERVICE_ROLE_KEY is
# also accepted during migration to secret keys.
SUPABASE_SECRET_KEY=your-supabase-secret-key
DIDIT_API_KEY=your-didit-api-key
DIDIT_WEBHOOK_SECRET=your-didit-webhook-signing-secret
AGENTPAY_BASE_URL=http://localhost:3210
AGENTPAY_RP_NAME=AgentPay
# The WebAuthn RP ID must exactly match the canonical AgentPay hostname.
AGENTPAY_RP_ID=localhost
AGENTPAY_RP_ORIGIN=http://localhost:3210
AGENTPAY_ENCRYPTION_KEY=replace-with-32-byte-base64-secret
AGENTPAY_REGISTRY_PRIVATE_KEY=replace-with-base64-pkcs8-ed25519-private-key
AGENTPAY_REGISTRY_PUBLIC_KEY=replace-with-base64-spki-ed25519-public-key
