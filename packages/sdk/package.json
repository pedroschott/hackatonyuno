{
  "name": "@agentic-mandates/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "./node_modules/.bin/tsc --project tsconfig.json",
    "typecheck": "./node_modules/.bin/tsc --project tsconfig.json --noEmit && ./node_modules/.bin/tsc --project tsconfig.test.json --noEmit",
    "test": "./node_modules/.bin/vitest run",
    "test:watch": "./node_modules/.bin/vitest"
  },
  "dependencies": {
    "@agentic-mandates/contracts": "workspace:*",
    "jose": "6.2.10",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
