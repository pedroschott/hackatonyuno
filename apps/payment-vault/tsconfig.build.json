{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/test-harness.ts", "tests/**/*.ts"]
}
