{
  "suiteVersion": "1.0",
  "id": "03-wrong-merchant",
  "title": "A capability cannot be presented by another merchant",
  "description": "A quote-bound capability issued for merchant-a is presented by merchant-b and must not reach the Vault.",
  "preconditions": {
    "clock": "2026-08-29T12:00:00.000Z",
    "mandate": {
      "id": "mandate-wrong-merchant-1",
      "status": "active",
      "version": 1,
      "paymentMethodId": "pm-fixture-primary",
      "policy": {
        "permittedAgentId": "agent-primary",
        "merchantAllowlist": ["merchant-a", "merchant-b"],
        "allowedCanonicalCategoryPaths": ["food.pantry"],
        "maxAmountMinor": 50000,
        "totalBudgetMinor": 50000,
        "remainingAuthorityMinor": 50000,
        "currency": "USD"
      }
    },
    "quote": {
      "id": "quote-merchant-a-350",
      "merchantId": "merchant-a",
      "merchantOrderRef": "order-merchant-a-350",
      "totalMinor": 35000,
      "currency": "USD",
      "canonicalCategories": ["food.pantry.rice"],
      "signature": "valid merchant fixture signature"
    }
  },
  "steps": [
    {
      "id": "issue-merchant-a-capability",
      "kind": "agent-intent",
      "input": {
        "actor": "agent-primary",
        "mandateId": "mandate-wrong-merchant-1",
        "merchantId": "merchant-a",
        "quoteId": "quote-merchant-a-350",
        "idempotencyKey": "intent-merchant-a-350"
      }
    },
    {
      "id": "merchant-b-presents-capability",
      "kind": "merchant-verification",
      "input": {
        "actor": "merchant-b",
        "merchantId": "merchant-b",
        "merchantOrderRef": "order-merchant-b-substitution",
        "quoteId": "quote-merchant-a-350",
        "purchaseCapability": "$purchaseCapability",
        "idempotencyKey": "verify-wrong-merchant"
      }
    }
  ],
  "expected": {
    "outcomes": [
      {
        "step": "issue-merchant-a-capability",
        "httpStatus": 200,
        "decision": "approved",
        "reasonCode": "AUTHORIZED"
      },
      {
        "step": "merchant-b-presents-capability",
        "httpStatus": 200,
        "decision": "rejected",
        "reasonCode": "MERCHANT_MISMATCH"
      }
    ],
    "invariants": {
      "vaultCalls": [],
      "capturedAmountMinorDelta": 0,
      "capabilityConsumed": false
    }
  }
}
