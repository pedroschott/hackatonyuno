{
  "suiteVersion": "1.0",
  "id": "01-valid-purchase",
  "title": "A valid quote-bound purchase captures exactly once",
  "description": "An authenticated permitted agent purchases an allowed rice quote within both limits.",
  "preconditions": {
    "clock": "2026-08-29T12:00:00.000Z",
    "actors": {
      "principal": "principal-1",
      "agent": "agent-primary",
      "merchant": "merchant-a"
    },
    "mandate": {
      "id": "mandate-valid-1",
      "status": "active",
      "version": 1,
      "paymentMethodId": "pm-fixture-primary",
      "policy": {
        "permittedAgentId": "agent-primary",
        "merchantAllowlist": ["merchant-a"],
        "allowedCanonicalCategoryPaths": ["food.pantry"],
        "maxAmountMinor": 50000,
        "totalBudgetMinor": 50000,
        "remainingAuthorityMinor": 50000,
        "currency": "USD"
      }
    },
    "quote": {
      "id": "quote-valid-350",
      "merchantId": "merchant-a",
      "merchantOrderRef": "order-valid-350",
      "totalMinor": 35000,
      "currency": "USD",
      "canonicalCategories": ["food.pantry.rice"],
      "signature": "valid merchant fixture signature"
    },
    "paymentVault": { "scenario": "captured" }
  },
  "steps": [
    {
      "id": "issue-capability",
      "kind": "agent-intent",
      "input": {
        "actor": "agent-primary",
        "mandateId": "mandate-valid-1",
        "merchantId": "merchant-a",
        "quoteId": "quote-valid-350",
        "idempotencyKey": "intent-valid-350"
      }
    },
    {
      "id": "verify-and-capture",
      "kind": "merchant-verification",
      "input": {
        "actor": "merchant-a",
        "merchantId": "merchant-a",
        "merchantOrderRef": "order-valid-350",
        "quoteId": "quote-valid-350",
        "purchaseCapability": "$purchaseCapability",
        "idempotencyKey": "verify-valid-350"
      }
    }
  ],
  "expected": {
    "outcomes": [
      {
        "step": "issue-capability",
        "httpStatus": 200,
        "decision": "approved",
        "reasonCode": "AUTHORIZED"
      },
      {
        "step": "verify-and-capture",
        "httpStatus": 200,
        "decision": "approved",
        "reasonCode": "AUTHORIZED",
        "settlementStatus": "captured"
      }
    ],
    "invariants": {
      "vaultCalls": ["authorize", "capture"],
      "captureCount": 1,
      "capturedAmountMinorDelta": 35000,
      "capturedUsesDelta": 1
    }
  }
}
